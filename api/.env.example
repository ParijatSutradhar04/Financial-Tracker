# Copy to api/.env and fill in. Never commit api/.env.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/financedb
PORT=8000
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:8443
APP_TIMEZONE=Asia/Kolkata
SUPABASE_URL=https://<project-ref>.supabase.co
DB_POOL_MAX=3

# Laya categorizer Space used by Splitwise import (optional)
LAYA_SPACE_URL=https://<hf-username>-laya-categorizer.hf.space
LAYA_HF_TOKEN=hf_xxx
